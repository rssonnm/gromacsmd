; ============================================================
; Production MD — 500 ns
; NPT ensemble (constant N, P, T)
; Q1-level MD simulation — CHARMM36m / AMBER-compatible
; Reference: Best et al., JCTC 2012; Huang & MacKerell, JCC 2013
;            Parrinello & Rahman, JAP 1981; GROMACS manual 2023
; ============================================================

title               = Protein-ligand complex MD simulation (500 ns)

; ── Run Control ─────────────────────────────────────────────
integrator          = md            ; leap-frog stochastic dynamics integrator
nsteps              = 250000000     ; 250,000,000 * 2 fs = 500,000 ps = 500 ns
dt                  = 0.002         ; 2 fs timestep

; ── Output Control ──────────────────────────────────────────
; Balance storage vs. analysis resolution (10 ps frames → 50,000 frames/500 ns)
nstxout             = 0             ; no full-precision .trr positions (use .xtc)
nstvout             = 0             ; no .trr velocities
nstfout             = 0             ; no .trr forces
nstenergy           = 5000          ; save energies every 10 ps
nstlog              = 5000          ; update log every 10 ps
nstxout-compressed  = 5000          ; save compressed .xtc every 10 ps

; ── Bond Constraints ────────────────────────────────────────
continuation        = yes           ; continuing from NPT equilibration
constraint_algorithm = lincs        ; Linear Constraint Solver (LINCS)
constraints         = h-bonds       ; constrain all X-H bonds (allows 2 fs dt)
lincs_iter          = 2             ; LINCS correction iterations (default 1; 2 for accuracy)
lincs_order         = 6             ; matrix expansion order (default 4; 6 for accuracy)
lincs-warnangle     = 30            ; warn if angle deviation > 30°

; ── Neighbor Searching ──────────────────────────────────────
cutoff-scheme       = Verlet        ; buffered pair list (GPU-compatible)
ns_type             = grid
nstlist             = 10            ; neighbor list update frequency (steps)
verlet-buffer-tolerance = 0.005     ; target energy drift (kJ/mol/ps/atom)
rlist               = 1.2           ; pair-list cutoff (nm); usually = rcoulomb

; ── Electrostatics ──────────────────────────────────────────
coulombtype         = PME           ; Particle Mesh Ewald (gold standard for periodic systems)
rcoulomb            = 1.2           ; PME real-space cutoff (nm)
pme_order           = 4             ; cubic B-spline interpolation
fourierspacing      = 0.12          ; PME reciprocal-space grid spacing (nm)
                                    ; 0.12 nm is more accurate than common 0.16 nm

; ── Van der Waals ───────────────────────────────────────────
vdwtype             = cutoff
vdw-modifier        = force-switch  ; CHARMM36 force-switch (Steinbach & Brooks 1994)
rvdw-switch         = 1.0           ; switching onset (nm)
rvdw                = 1.2           ; VdW cutoff (nm)

; ── Dispersion Correction ────────────────────────────────────
; Must be OFF when using force-switch modifier (CHARMM36 protocol)
DispCorr            = no

; ── Temperature Coupling ─────────────────────────────────────
; V-rescale: canonical ensemble with correct fluctuations (Bussi et al., JCP 2007)
tcoupl              = V-rescale
tc-grps             = Protein_LIG Water_and_ions    ; two coupling groups
tau_t               = 0.1   0.1                     ; time constant (ps)
ref_t               = 300   300                     ; target temperature (K)

; ── Pressure Coupling ────────────────────────────────────────
; Parrinello-Rahman: correct NPT ensemble for production MD
; (Berendsen is used only during equilibration)
pcoupl              = Parrinello-Rahman
pcoupltype          = isotropic                     ; isotropic box scaling
tau_p               = 2.0                           ; barostat time constant (ps)
ref_p               = 1.0                           ; reference pressure (bar)
compressibility     = 4.5e-5                        ; isothermal compressibility of water (bar^-1)

; ── Periodic Boundary Conditions ────────────────────────────
pbc                 = xyz

; ── Center-of-Mass Motion Removal ───────────────────────────
; Prevents "flying ice cube" artifact in long simulations
comm-mode           = Linear        ; remove linear COM translation
nstcomm             = 100           ; COM removal frequency (steps)
comm-grps           = System        ; apply to entire system

; ── Velocity Generation ─────────────────────────────────────
gen_vel             = no            ; velocities inherited from NPT equilibration
