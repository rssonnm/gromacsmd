; ============================================================
; Energy Minimization (EM) - Steepest Descent
; Q1-level MD simulation parameters
; Force field: CHARMM36m / AMBER-compatible
; Reference: Best et al., JCTC 2012; GROMACS manual 2023
; ============================================================

title               = Energy Minimization

; ── Run Control ─────────────────────────────────────────────
integrator          = steep         ; steepest descent minimization
emtol               = 500.0         ; converge when Fmax < 500 kJ/mol/nm
emstep              = 0.01          ; initial step size (nm)
nsteps              = 100000        ; max minimization steps

; ── Neighbor Searching ──────────────────────────────────────
cutoff-scheme       = Verlet        ; buffered neighbor searching (default since GROMACS 5)
ns_type             = grid          ; grid-based neighbor list
nstlist             = 1             ; update neighbor list every step (EM always uses 1)
rlist               = 1.2           ; short-range cutoff (nm) — consistent with rcoulomb/rvdw

; ── Electrostatics ──────────────────────────────────────────
coulombtype         = PME           ; Particle Mesh Ewald for long-range electrostatics
rcoulomb            = 1.2           ; real-space PME cutoff (nm)
pme_order           = 4             ; cubic B-spline interpolation
fourierspacing      = 0.12          ; PME FFT grid spacing (nm); finer than 0.16 for accuracy

; ── Van der Waals ───────────────────────────────────────────
vdwtype             = cutoff
vdw-modifier        = force-switch  ; CHARMM36 recommended switching function
rvdw-switch         = 1.0           ; distance at which switching begins (nm)
rvdw                = 1.2           ; VdW cutoff (nm)

; ── Dispersion Correction ────────────────────────────────────
; Disabled per CHARMM36 / PME+force-switch recommendations
; (DispCorr interferes with force-switch modifier)
DispCorr            = no

; ── Periodic Boundary Conditions ────────────────────────────
pbc                 = xyz           ; full 3-D PBC
