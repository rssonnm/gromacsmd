; ============================================================
; Ion Placement Pre-processing (ions.mdp)
; Minimal run for genion — uses steepest descent without PME
; Q1-level MD simulation parameters
; ============================================================

title               = Ion placement pre-processing

; ── Run Control ─────────────────────────────────────────────
integrator          = steep
emtol               = 1000.0        ; lenient — only for genion preprocessing
emstep              = 0.01
nsteps              = 50000

; ── Neighbor Searching ──────────────────────────────────────
cutoff-scheme       = Verlet
ns_type             = grid
nstlist             = 1
rlist               = 1.2

; ── Electrostatics ──────────────────────────────────────────
; Use reaction-field (not PME) for genion step — avoids FFT for large boxes
coulombtype         = cutoff        ; simple cutoff acceptable for genion
rcoulomb            = 1.2

; ── Van der Waals ───────────────────────────────────────────
vdwtype             = cutoff
rvdw                = 1.2

; ── Periodic Boundary Conditions ────────────────────────────
pbc                 = xyz
