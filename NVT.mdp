; ============================================================
; NVT Equilibration (canonical ensemble, constant T)
; Stage: After energy minimization, before NPT
; Duration: 1 ns with heavy-atom position restraints
; Q1-level MD simulation — CHARMM36m / AMBER-compatible
; Reference: Bjelkmar et al. JCTC 2010; Lindahl et al. 2020
; ============================================================

title               = Protein-ligand complex NVT equilibration (1 ns)
define              = -DPOSRES      ; activate position restraints (protein + ligand)

; ── Run Control ─────────────────────────────────────────────
integrator          = md            ; velocity Verlet leap-frog integrator
nsteps              = 500000        ; 500000 * 2 fs = 1000 ps = 1 ns
dt                  = 0.002         ; 2 fs timestep

; ── Output Control ──────────────────────────────────────────
nstxout             = 0             ; do not save .trr coordinates (save disk space)
nstvout             = 0             ; do not save velocities to .trr
nstfout             = 0             ; do not save forces to .trr
nstenergy           = 5000          ; save energies every 10 ps
nstlog              = 5000          ; update log every 10 ps
nstxout-compressed  = 5000          ; save .xtc coordinates every 10 ps

; ── Bond Constraints ────────────────────────────────────────
continuation        = no            ; first dynamics run — generate velocities
constraint_algorithm = lincs        ; holonomic constraints via LINCS
constraints         = h-bonds       ; constrain all H-bonds (recommended with 2 fs dt)
lincs_iter          = 2             ; increased iterations for accuracy (Q1 standard)
lincs_order         = 6             ; higher order → lower error (Q1 standard)
lincs-warnangle     = 30            ; warn if bond angle deviation > 30°

; ── Neighbor Searching ──────────────────────────────────────
cutoff-scheme       = Verlet
ns_type             = grid
nstlist             = 10            ; update frequency (auto-adjusted by GROMACS with Verlet)
verlet-buffer-tolerance = 0.005     ; target energy drift 0.005 kJ/mol/ps/atom (GROMACS default)
rlist               = 1.2

; ── Electrostatics ──────────────────────────────────────────
coulombtype         = PME           ; Particle Mesh Ewald
rcoulomb            = 1.2           ; PME real-space cutoff (nm)
pme_order           = 4             ; cubic B-spline
fourierspacing      = 0.12          ; PME FFT grid spacing (nm); finer grid for accuracy

; ── Van der Waals ───────────────────────────────────────────
vdwtype             = cutoff
vdw-modifier        = force-switch  ; CHARMM36 force-based switching
rvdw-switch         = 1.0           ; switching onset (nm)
rvdw                = 1.2           ; VdW cutoff (nm)

; ── Dispersion Correction ────────────────────────────────────
DispCorr            = no            ; disabled for CHARMM36 + force-switch

; ── Temperature Coupling ────────────────────────────────────
tcoupl              = V-rescale                     ; velocity-rescaling thermostat (Bussi 2007)
tc-grps             = Protein_LIG Water_and_ions    ; separate coupling groups
tau_t               = 0.1   0.1                     ; relaxation time constant (ps)
ref_t               = 300   300                     ; reference temperature (K)

; ── Pressure Coupling ───────────────────────────────────────
pcoupl              = no            ; NVT: no pressure coupling

; ── Periodic Boundary Conditions ────────────────────────────
pbc                 = xyz

; ── Center-of-Mass Motion ───────────────────────────────────
comm-mode           = Linear        ; remove linear COM motion
nstcomm             = 100           ; frequency of COM removal (steps)
comm-grps           = System        ; apply to whole system

; ── Velocity Generation ─────────────────────────────────────
gen_vel             = yes           ; generate Maxwell-Boltzmann velocities
gen_temp            = 300           ; temperature for velocity distribution (K)
gen_seed            = -1            ; random seed (reproducible: set positive integer)
