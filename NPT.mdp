; ============================================================
; NPT Equilibration (isothermal-isobaric ensemble)
; Stage: After NVT, before production MD
; Duration: 5 ns with heavy-atom position restraints
; Q1-level MD simulation — CHARMM36m / AMBER-compatible
; Reference: Parrinello & Rahman, JAP 1981; GROMACS manual 2023
; ============================================================

title               = Protein-ligand complex NPT equilibration (5 ns)
define              = -DPOSRES      ; activate position restraints (protein + ligand)

; ── Run Control ─────────────────────────────────────────────
integrator          = md            ; velocity Verlet leap-frog integrator
nsteps              = 2500000       ; 2500000 * 2 fs = 5000 ps = 5 ns
dt                  = 0.002         ; 2 fs timestep

; ── Output Control ──────────────────────────────────────────
nstxout             = 0             ; do not save .trr coordinates
nstvout             = 0             ; do not save velocities
nstfout             = 0             ; do not save forces
nstenergy           = 5000          ; save energies every 10 ps
nstlog              = 5000          ; update log every 10 ps
nstxout-compressed  = 5000          ; save .xtc coordinates every 10 ps

; ── Bond Constraints ────────────────────────────────────────
continuation        = yes           ; continuing from NVT equilibration
constraint_algorithm = lincs        ; holonomic constraints via LINCS
constraints         = h-bonds       ; constrain all H-bonds
lincs_iter          = 2             ; increased iterations for accuracy (Q1 standard)
lincs_order         = 6             ; higher order → lower error (Q1 standard)
lincs-warnangle     = 30

; ── Neighbor Searching ──────────────────────────────────────
cutoff-scheme       = Verlet
ns_type             = grid
nstlist             = 10
verlet-buffer-tolerance = 0.005     ; energy drift tolerance kJ/mol/ps/atom
rlist               = 1.2

; ── Electrostatics ──────────────────────────────────────────
coulombtype         = PME
rcoulomb            = 1.2
pme_order           = 4
fourierspacing      = 0.12          ; finer FFT grid for accuracy

; ── Van der Waals ───────────────────────────────────────────
vdwtype             = cutoff
vdw-modifier        = force-switch  ; CHARMM36 recommended
rvdw-switch         = 1.0
rvdw                = 1.2

; ── Dispersion Correction ────────────────────────────────────
DispCorr            = no            ; disabled for CHARMM36 + force-switch

; ── Temperature Coupling ─────────────────────────────────────
tcoupl              = V-rescale                     ; Bussi velocity-rescaling thermostat
tc-grps             = Protein_LIG Water_and_ions
tau_t               = 0.1   0.1
ref_t               = 300   300

; ── Pressure Coupling ────────────────────────────────────────
; Berendsen is appropriate for NPT equilibration to allow box volume to relax
; (Parrinello-Rahman is used in production MD)
pcoupl              = Berendsen
pcoupltype          = isotropic
tau_p               = 2.0           ; pressure relaxation time (ps)
ref_p               = 1.0           ; reference pressure (bar)
compressibility     = 4.5e-5        ; isothermal compressibility of water (bar^-1)
refcoord_scaling    = com           ; scale COM of position-restrained atoms

; ── Periodic Boundary Conditions ────────────────────────────
pbc                 = xyz

; ── Center-of-Mass Motion ───────────────────────────────────
comm-mode           = Linear
nstcomm             = 100
comm-grps           = System

; ── Velocity Generation ─────────────────────────────────────
gen_vel             = no            ; velocities inherited from NVT equilibration
